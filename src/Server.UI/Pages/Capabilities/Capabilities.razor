@page "/pages/capabilities"

@using CleanArchitecture.Blazor.Application.Features.Capabilities.Caching
@using CleanArchitecture.Blazor.Application.Features.Capabilities.DTOs

@inject IStringLocalizer<Capabilities> L
@attribute [Authorize(Policy = Permissions.Capabilities.View)]

<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             Virtualize="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             MultiSelection="true"
             T="CapabilityDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnDataGridRowClick(s.Item))"
             @bind-SelectedItems="_selectedCapabilities"
             Hover="true" @ref="_capabilitiesGrid">
    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Construction" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage business capabilities and their relationships</MudText>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @ConstantString.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @ConstantString.New
                        </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@ConstantString.More">
                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem Disabled="@(!(_selectedCapabilities.Count > 0))"
                                         OnClick="OnDeleteSelectedCapabilities">
                                @ConstantString.Delete
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_searchString" Placeholder="@ConstantString.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn HeaderStyle="width:60px" Title="@ConstantString.Actions" Sortable="false">
            <CellTemplate>
                @if (_accessRights.Edit || _accessRights.Delete)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                        @if (_accessRights.Edit)
                        {
                            <MudMenuItem OnClick="@(()=>OnEditCapability(context.Item))">@ConstantString.Edit</MudMenuItem>
                        }
                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem OnClick="@(()=>OnDeleteCapability(context.Item))">@ConstantString.Delete</MudMenuItem>
                        }
                    </MudMenu>
                }
                else
                {
                    <MudTooltip Text="@ConstantString.NoAllowed" Delay="300">
                        <MudIconButton Variant="Variant.Outlined"  
                                       Disabled="true"
                                       Icon="@Icons.Material.Filled.DoNotTouch"
                                       Size="Size.Small"
                                       Color="Color.Surface">
                            @ConstantString.NoAllowed
                        </MudIconButton>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name" Title="@L[_capabilityDto.GetMemberDescription(x=>x.Name)]"> 
            <CellTemplate>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.Item.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
                </div>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Category" Title="@L[_capabilityDto.GetMemberDescription(x=>x.Category)]" />
        <PropertyColumn Property="x => x.Level" Title="@L[_capabilityDto.GetMemberDescription(x=>x.Level)]">
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.Level))
                {
                    <MudChip Size="Size.Small" Color="GetLevelColor(context.Item.Level)">@context.Item.Level</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Status" Title="@L[_capabilityDto.GetMemberDescription(x=>x.Status)]">
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.Status))
                {
                    <MudChip Size="Size.Small" Color="GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.MaturityLevel" Title="@L[_capabilityDto.GetMemberDescription(x=>x.MaturityLevel)]" />
        <PropertyColumn Property="x => x.Owner" Title="@L[_capabilityDto.GetMemberDescription(x=>x.Owner)]" />
        <PropertyColumn Property="x => x.Priority" Title="@L[_capabilityDto.GetMemberDescription(x=>x.Priority)]" />
        <PropertyColumn Property="x => x.SystemsCount" Title="Systems" />
    </Columns>
    <NoRecordsContent>
        <MudText>@ConstantString.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@ConstantString.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500,1000})" />
    </PagerContent>
</MudDataGrid>

@code {
    public string? Title { get; private set; }
    private int _defaultPageSize = 15;
    private HashSet<CapabilityDto> _selectedCapabilities = new HashSet<CapabilityDto>();
    private MudDataGrid<CapabilityDto> _capabilitiesGrid = default!;
    private CapabilityDto _capabilityDto = new();
    private bool _loading;
    private string _searchString = string.Empty;
    
    [CascadingParameter]
    private UserProfile? UserProfile { get; set; }

    private CapabilitiesAccessRights _accessRights = new();

    protected override async Task OnInitializedAsync()
    {
        Title = L[_capabilityDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<CapabilitiesAccessRights>();
    }

    private async Task<GridData<CapabilityDto>> ServerReload(GridState<CapabilityDto> state)
    {
        try
        {
            _loading = true;
            // Mock data for now - implement proper query later
            var mockData = new List<CapabilityDto>
            {
                new CapabilityDto 
                { 
                    Id = 1, 
                    Name = "Customer Management", 
                    Description = "Manage customer information and relationships",
                    Category = "Customer Service",
                    Level = "Strategic",
                    Status = "Active",
                    MaturityLevel = "Managed",
                    Owner = "Sales Team",
                    Priority = 1,
                    SystemsCount = 3
                },
                new CapabilityDto 
                { 
                    Id = 2, 
                    Name = "Financial Reporting", 
                    Description = "Generate financial reports and analytics",
                    Category = "Finance",
                    Level = "Operational",
                    Status = "Active",
                    MaturityLevel = "Optimizing",
                    Owner = "Finance Team",
                    Priority = 2,
                    SystemsCount = 2
                }
            };
            
            var filteredData = mockData.Where(x => string.IsNullOrEmpty(_searchString) || 
                x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
            
            return new GridData<CapabilityDto>() { TotalItems = filteredData.Count, Items = filteredData };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string text)
    {
        _selectedCapabilities.Clear();
        _searchString = text;
        await _capabilitiesGrid.ReloadServerData();
    }

    private async Task OnRefresh()
    {
        CapabilityCacheKey.Refresh();
        _selectedCapabilities.Clear();
        _searchString = string.Empty;
        await _capabilitiesGrid.ReloadServerData();
    }

    private void OnDataGridRowClick(CapabilityDto dto)
    {
        Navigation.NavigateTo($"/pages/capabilities/view/{dto.Id}");
    }

    private Task OnCreate()
    {
        Navigation.NavigateTo("/pages/capabilities/create");
        return Task.CompletedTask;
    }

    private Task OnEditCapability(CapabilityDto dto)
    {
        Navigation.NavigateTo($"/pages/capabilities/edit/{dto.Id}");
        return Task.CompletedTask;
    }

    private Task OnDeleteCapability(CapabilityDto dto)
    {
        // Implementation for delete - to be added
        return Task.CompletedTask;
    }

    private Task OnDeleteSelectedCapabilities()
    {
        // Implementation for batch delete - to be added
        return Task.CompletedTask;
    }

    private Color GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => Color.Success,
            "deprecated" => Color.Warning,
            "planned" => Color.Info,
            _ => Color.Default
        };
    }

    private Color GetLevelColor(string level)
    {
        return level?.ToLower() switch
        {
            "strategic" => Color.Error,
            "tactical" => Color.Warning,
            "operational" => Color.Info,
            _ => Color.Default
        };
    }
}