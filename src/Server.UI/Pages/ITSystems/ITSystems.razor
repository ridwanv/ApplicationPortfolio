@page "/pages/itsystems"

@using CleanArchitecture.Blazor.Application.Features.ITSystems.Caching
@using CleanArchitecture.Blazor.Application.Features.ITSystems.DTOs
@using CleanArchitecture.Blazor.Application.Features.ITSystems.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.ITSystems.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.ITSystems.Commands.Update
@using CleanArchitecture.Blazor.Server.UI.Pages.ITSystems.Components

@inject IStringLocalizer<ITSystems> L
@attribute [Authorize(Policy = Permissions.ITSystems.View)]

<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             Virtualize="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             MultiSelection="true"
             T="ITSystemDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnDataGridRowClick(s.Item))"
             @bind-SelectedItems="_selectedITSystems"
             Hover="true" @ref="_itSystemsGrid">
    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage IT systems and their relationships</MudText>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @ConstantString.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @ConstantString.New
                        </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@ConstantString.More">
                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem Disabled="@(!(_selectedITSystems.Count > 0))"
                                         OnClick="OnDeleteSelectedITSystems">
                                @ConstantString.Delete
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_searchString" Placeholder="@ConstantString.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn HeaderStyle="width:60px" Title="@ConstantString.Actions" Sortable="false">
            <CellTemplate>
                @if (_accessRights.Edit || _accessRights.Delete)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                        @if (_accessRights.Edit)
                        {
                            <MudMenuItem OnClick="@(()=>OnEditITSystem(context.Item))">@ConstantString.Edit</MudMenuItem>
                        }
                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem OnClick="@(()=>OnDeleteITSystem(context.Item))">@ConstantString.Delete</MudMenuItem>
                        }
                    </MudMenu>
                }
                else
                {
                    <MudTooltip Text="@ConstantString.NoAllowed" Delay="300">
                        <MudIconButton Variant="Variant.Outlined"  
                                       Disabled="true"
                                       Icon="@Icons.Material.Filled.DoNotTouch"
                                       Size="Size.Small"
                                       Color="Color.Surface">
                            @ConstantString.NoAllowed
                        </MudIconButton>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name" Title="@L[_itSystemDto.GetMemberDescription(x=>x.Name)]"> 
            <CellTemplate>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.Item.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
                </div>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Status" Title="@L[_itSystemDto.GetMemberDescription(x=>x.Status)]">
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.Status))
                {
                    <MudChip Size="Size.Small" Color="GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Category" Title="@L[_itSystemDto.GetMemberDescription(x=>x.Category)]" />
        <PropertyColumn Property="x => x.Owner" Title="@L[_itSystemDto.GetMemberDescription(x=>x.Owner)]" />
        <PropertyColumn Property="x => x.CriticalityLevel" Title="@L[_itSystemDto.GetMemberDescription(x=>x.CriticalityLevel)]">
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.CriticalityLevel))
                {
                    <MudChip Size="Size.Small" Color="GetCriticalityColor(context.Item.CriticalityLevel)">@context.Item.CriticalityLevel</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.SubSystemsCount" Title="Sub Systems" />
        <PropertyColumn Property="x => x.CapabilitiesCount" Title="Capabilities" />
    </Columns>
    <NoRecordsContent>
        <MudText>@ConstantString.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@ConstantString.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500,1000})" />
    </PagerContent>
</MudDataGrid>

@code {
    public string? Title { get; private set; }
    private int _defaultPageSize = 15;
    private HashSet<ITSystemDto> _selectedITSystems = new HashSet<ITSystemDto>();
    private MudDataGrid<ITSystemDto> _itSystemsGrid = default!;
    private ITSystemDto _itSystemDto = new();
    private bool _loading;
    private string _searchString = string.Empty;
    
    [CascadingParameter]
    private UserProfile? UserProfile { get; set; }

    private ITSystemsAccessRights _accessRights = new();

    protected override async Task OnInitializedAsync()
    {
        Title = L[_itSystemDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<ITSystemsAccessRights>();
    }

    private async Task<GridData<ITSystemDto>> ServerReload(GridState<ITSystemDto> state)
    {
        try
        {
            _loading = true;
            // For now, return mock data - implement pagination query later
            var result = await Mediator.Send(new GetAllITSystemsQuery());
            var filteredData = result.Where(x => string.IsNullOrEmpty(_searchString) || 
                x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
            
            return new GridData<ITSystemDto>() { TotalItems = filteredData.Count, Items = filteredData };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string text)
    {
        _selectedITSystems.Clear();
        _searchString = text;
        await _itSystemsGrid.ReloadServerData();
    }

    private async Task OnRefresh()
    {
        ITSystemCacheKey.Refresh();
        _selectedITSystems.Clear();
        _searchString = string.Empty;
        await _itSystemsGrid.ReloadServerData();
    }

    private async Task ShowEditFormDialog(string title, object command)
    {
        var parameters = new DialogParameters<ITSystemFormDialog>
        {
            [nameof(ITSystemFormDialog._model)] = command,
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<ITSystemFormDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await _itSystemsGrid.ReloadServerData();
            _selectedITSystems.Clear();
        }
    }

    private void OnDataGridRowClick(ITSystemDto dto)
    {
        Navigation.NavigateTo($"/pages/itsystems/view/{dto.Id}");
    }

    private Task OnCreate()
    {
        var command = new CreateITSystemCommand();
        return ShowEditFormDialog(L["New IT System"], command);
    }

    private Task OnEditITSystem(ITSystemDto dto)
    {
        Navigation.NavigateTo($"/pages/itsystems/edit/{dto.Id}");
        return Task.CompletedTask;
    }

    private Task OnDeleteITSystem(ITSystemDto dto)
    {
        var contentText = string.Format(ConstantString.DeleteConfirmation, dto.Name);
        var command = new DeleteITSystemCommand(new int[] { dto.Id });
        return DeleteITSystemsInternal(command, contentText); 
    }

    private Task OnDeleteSelectedITSystems()
    {
        var contentText = string.Format(ConstantString.DeleteConfirmWithSelected, _selectedITSystems.Count);
        var command = new DeleteITSystemCommand(_selectedITSystems.Select(x => x.Id).ToArray());
        return DeleteITSystemsInternal(command, contentText);
    }

    private Task DeleteITSystemsInternal(DeleteITSystemCommand command, string contentText)
    {
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            ConstantString.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                await _itSystemsGrid.ReloadServerData();
                _selectedITSystems.Clear();
            });
    }

    private Color GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => Color.Success,
            "inactive" => Color.Warning,
            "deprecated" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetCriticalityColor(string criticality)
    {
        return criticality?.ToLower() switch
        {
            "critical" => Color.Error,
            "high" => Color.Warning,
            "medium" => Color.Info,
            "low" => Color.Success,
            _ => Color.Default
        };
    }
}