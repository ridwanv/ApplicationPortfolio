@page "/pages/systems"
@using CleanArchitecture.Blazor.Application.Features.Systems.DTOs
@using CleanArchitecture.Blazor.Application.Features.Systems.Queries.GetPaged
@using CleanArchitecture.Blazor.Application.Features.Systems.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Systems.Queries.Export
@using CleanArchitecture.Blazor.Server.UI.Pages.Systems.Components

@attribute [Authorize(Policy = Permissions.Systems.View)]
@inject IStringLocalizer<Systems> L

<PageTitle>Systems</PageTitle>

<MudStack Spacing="2">
    <MudText Typo="Typo.h5">@L["Systems"]</MudText>
    <MudStack Row Spacing="1">
        @if (_accessRights.Create)
        {
            <MudButton StartIcon="@Icons.Material.Outlined.Add" OnClick="OnCreate">@L["New"]</MudButton>
        }
        @if (_accessRights.Export)
        {
            <MudButton StartIcon="@Icons.Material.Outlined.Download" OnClick="(() => OnExport(ExportType.Excel))">@L["Export CSV/XLSX"]</MudButton>
            <MudButton StartIcon="@Icons.Material.Outlined.PictureAsPdf" OnClick="(() => OnExport(ExportType.PDF))">@L["Export PDF"]</MudButton>
        }
    </MudStack>
    <MudTable Items="_items" Loading="_loading">
        <HeaderContent>
            <MudTh>@L["Name"]</MudTh>
            <MudTh>@L["Category"]</MudTh>
            <MudTh>@L["Hosting"]</MudTh>
            <MudTh>@L["Lifecycle"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Category">@context.Category</MudTd>
            <MudTd DataLabel="Hosting">@context.Hosting</MudTd>
            <MudTd DataLabel="Lifecycle">@context.LifecycleStage</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="(() => OnView(context.Id))">@L["View"]</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudStack>

@code {
    private SystemsAccessRights _accessRights = new();
    private bool _loading;
    private List<SystemDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _accessRights = await PermissionService.GetAccessRightsAsync<SystemsAccessRights>();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Mediator.Send(new GetPagedSystemsQuery { PageNumber = 1, PageSize = 50 });
        _items = result.Items.ToList();
        _loading = false;
    }

    private async Task OnCreate()
    {
        if (!_accessRights.Create)
        {
            Snackbar.Add(L["You do not have permission."], Severity.Warning);
            return;
        }
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<SystemFormDialog>(L["New System"], options);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadAsync();
    }

    private async Task OnExport(ExportType type)
    {
        var response = await Mediator.Send(new ExportSystemsQuery { ExportType = type });
        if (response.Succeeded)
        {
            var bytes = response.Data!;
            var fileName = type == ExportType.PDF ? "systems.pdf" : "systems.xlsx";
            var contentType = type == ExportType.PDF ? "application/pdf" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await BlazorDownloadFileService.DownloadFile(fileName, bytes, contentType);
        }
        else
        {
            Snackbar.Add(response.Messages.FirstOrDefault() ?? L["Export failed"], Severity.Error);
        }
    }

    private void OnView(int id)
    {
        Navigation.NavigateTo($"/pages/systems/{id}");
    }
}

